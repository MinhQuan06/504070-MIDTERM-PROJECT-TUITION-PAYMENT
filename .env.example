# Copy file này thành .env rồi đổi giá trị. KHÔNG commit .env.

USER_DB_NAME=user_db
USER_DB_USER=user_svc
USER_DB_PASSWORD=change_me_user
USER_DB_ROOT_PASSWORD=change_me_user_root
USER_DB_PORT=3309

PAYMENT_DB_NAME=payment_db
PAYMENT_DB_USER=payment_svc
PAYMENT_DB_PASSWORD=change_me_payment
PAYMENT_DB_ROOT_PASSWORD=change_me_payment_root

# Chỉ bật true để demo khi User/Student chưa có triển khai.
PAYMENT_MOCK_ENABLED=false
# User và Student dùng API thật.
PAYMENT_USER_MOCK_ENABLED=false
PAYMENT_STUDENT_MOCK_ENABLED=false
USER_SERVICE_URL=http://user-service:8001
STUDENT_SERVICE_URL=http://student-service:5071

STUDENT_DB_NAME=student_db
STUDENT_DB_USER=student_svc
STUDENT_DB_PASSWORD=change_me_student
STUDENT_DB_ROOT_PASSWORD=change_me_student_root
STUDENT_DB_PORT=3308

# RabbitMQ
RABBITMQ_USER=notification
RABBITMQ_PASSWORD=notification_dev

# JWT (chọn chuỗi dài, ngẫu nhiên)
JWT_SECRET_KEY=

# Shared by Payment -> User and Payment -> Student; generated by init-secrets.mjs.
USER_INTERNAL_API_KEY=
JWT_ISSUER=ibanking-user-auth
JWT_AUDIENCE=ibanking-api
JWT_EXPIRE_MINUTES=30

# Email: khi dev dùng Mailpit (SMTP localhost:1025)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=no-reply@tuition.local

# Notification Service (Docker; localhost khi chạy service ngoài container)
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
SMTP_USER=
SMTP_PASSWORD=
NOTIFICATION_MAX_RETRIES=3
NOTIFICATION_RETRY_DELAY_MS=5000

# Required: generate 32 random bytes in Base64 (see Payment README). Never commit a real key.
OUTBOX_ENCRYPTION_KEY=
OUTBOX_ENABLED=true
OUTBOX_POLL_DELAY_MS=1000
OUTBOX_CONFIRM_TIMEOUT_MS=5000

# Payment reconciliation (retry schedules use UTC).
SAGA_RECOVERY_ENABLED=true
SAGA_POLL_DELAY_MS=1000

# Trusted Gateway address for client-IP forwarding. Change subnet, dynamic range and Gateway address together if they conflict.
DOCKER_SUBNET=172.29.70.0/24
GATEWAY_INTERNAL_IP=172.29.70.2
DOCKER_DYNAMIC_RANGE=172.29.70.128/25
