{
  "name": "notification-service",
  "version": "1.0.0",
  "private": true,
  "description": "Independent iBanking email notification worker",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "start:dev": "tsx watch src/main.ts",
    "test": "tsx --test test/*.test.ts",
    "demo:otp": "tsx scripts/publish.ts OtpRequested",
    "demo:payment": "tsx scripts/publish.ts PaymentSucceeded",
    "smtp:check": "tsx scripts/check-smtp.ts",
    "test:contract": "tsx scripts/check-java-contract.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "amqp-connection-manager": "^4.1.14",
    "amqplib": "^0.10.8",
    "dotenv": "^16.4.7",
    "nodemailer": "^10.1.7",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.7",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
