# Chạy local với hạ tầng Compose ở thư mục gốc.
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=notification
RABBITMQ_PASSWORD=notification_dev
# RABBITMQ_URL=amqp://user:password@localhost:5672
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
