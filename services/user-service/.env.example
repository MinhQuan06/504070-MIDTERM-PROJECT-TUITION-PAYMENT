# Local machine MySQL connection (used when running FastAPI outside Docker)
DATABASE_URL=mysql+pymysql://root:@localhost:3306/user_db?charset=utf8mb4

# Generate two different random values, each at least 32 characters long.
JWT_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS_LONG
INTERNAL_API_KEY=CHANGE_ME_TO_ANOTHER_RANDOM_SECRET_AT_LEAST_32_CHARS

JWT_ISSUER=ibanking-user-auth
JWT_AUDIENCE=ibanking-api
JWT_EXPIRE_MINUTES=30
AUTO_CREATE_TABLES=false

# Docker Compose settings
# Use a simple alphanumeric/underscore password to avoid URL-encoding issues in DATABASE_URL.
MYSQL_ROOT_PASSWORD=local_mysql_dev_password
MYSQL_PORT=3307
AUTH_PORT=8001
